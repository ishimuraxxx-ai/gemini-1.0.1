{
  "manifest_version": 3,
  "name": "Gemini Voice",
  "version": "1.0.1",
  "description": "Язык интерфейса и голосовой ввод на любом языке для «Режима ИИ» Google Поиска",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "voice.js"
      ],
      "run_at": "document_idle",
      "css": [
        "hide.css"
      ]
    }
  ]
}
